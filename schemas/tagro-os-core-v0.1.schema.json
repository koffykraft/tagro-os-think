{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://tagro.in/schemas/tagro-os-core-v0.1.schema.json",
  "title":"TAGRO OS Core v0.1",
  "type":"object",
  "required":["id","type","version","status","provenance"],
  "properties":{
    "id":{"type":"string"},
    "type":{"enum":["mothership","dock","place","object","observation","evidence","knowledge","event","state","relationship","plane","decision","design","implementation","ripple","shadow"]},
    "version":{"type":"string"},
    "status":{"enum":["observed","measured","described","inferred","confirmed","proposed","accepted","installed","superseded","retired"]},
    "provenance":{"type":"object","required":["sourceType"],"properties":{"sourceType":{"enum":["owner","user","ai","sensor","map","photo","document","calculation","external"]},"sourceRef":{"type":"string"},"capturedAt":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1}}},
    "mothershipId":{"type":"string"},
    "dockId":{"type":"string"},
    "placeIds":{"type":"array","items":{"type":"string"}},
    "planeIds":{"type":"array","items":{"type":"string"}},
    "relationships":{"type":"array","items":{"type":"object","required":["type","targetId"],"properties":{"type":{"type":"string"},"targetId":{"type":"string"},"direction":{"enum":["upstream","downstream","bidirectional","contextual"]}}}},
    "dependsOn":{"type":"array","items":{"type":"string"}},
    "derivedFrom":{"type":"array","items":{"type":"string"}},
    "supersedes":{"type":"array","items":{"type":"string"}},
    "event":{"type":"object","properties":{"kind":{"type":"string"},"occurredAt":{"type":"string"},"scopeIds":{"type":"array","items":{"type":"string"}}}},
    "ripple":{"type":"object","properties":{"affectedIds":{"type":"array","items":{"type":"string"}},"recalculate":{"type":"array","items":{"type":"string"}},"preserve":{"type":"array","items":{"type":"string"}}}},
    "shadow":{"type":"object","properties":{"family":{"type":"string"},"failureMechanism":{"type":"string"},"evidenceRefs":{"type":"array","items":{"type":"string"}},"prevention":{"type":"array","items":{"type":"string"}}}},
    "payload":{"type":"object","additionalProperties":true}
  },
  "additionalProperties":true
}